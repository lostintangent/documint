{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@lostintangent/documint": ["./src/index.ts"],
      "@macros/*": ["./scripts/build/macros/*"],
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["playground", "src", "scripts", "test"]
}
