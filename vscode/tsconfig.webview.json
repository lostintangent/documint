{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "documint": ["../src/index.ts"],
      "@/*": ["../src/*"]
    },
    "noEmit": true
  },
  "include": ["src/webview/**/*", "src/types.ts"]
}
