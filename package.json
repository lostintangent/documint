{
  "name": "@lostintangent/documint",
  "version": "0.1.0",
  "workspaces": [
    "extensions/*"
  ],
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --hot playground/index.html --hostname=${DOCUMINT_DEV_HOST:-0.0.0.0} --port=3003",
    "build:dev": "bun scripts/build/build.ts",
    "build:prod": "tsdown && bun scripts/build/build.ts --prod",
    "build:playground": "bun scripts/build/build.ts --playground",
    "vscode:package": "bun check && cd extensions/vscode && bun package",
    "vscode:install": "code-insiders --install-extension extensions/vscode/documint-*.vsix --force",
    "github:install": "root=\"$PWD\" && cd \"$root/extensions/github\" && bun run build && target=\"$HOME/.copilot/extensions/documint\" && mkdir -p \"$(dirname \"$target\")\" && rm -rf \"$target\" && cp -R \"$root/extensions/github\" \"$target\"",
    "prepublishOnly": "bun build:prod",
    "test": "bun test",
    "check": "bun fmt --check && bun lint --max-warnings=0 && bun check && bun check -p extensions/vscode",
    "benchmark": "bun scripts/benchmarks/index.ts",
    "benchmark:moby-dick": "bun scripts/benchmarks/moby-dick.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@chenglou/pretext": "1.0.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "lucide-react": "^1.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "packageManager": "bun@1.4.4"
}
