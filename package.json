{
  "name": "@lostintangent/documint",
  "version": "0.0.35",
  "workspaces": [
    "extensions/*"
  ],
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --hot playground/index.html --hostname=0.0.0.0 --port=3003",
    "build:dev": "bun scripts/build/build.ts",
    "build:prod": "vp pack && bun scripts/build/build.ts --prod",
    "build:playground": "bun scripts/build/build.ts --playground",
    "vscode:package": "bun check && cd extensions/vscode && bun package",
    "vscode:install": "code-insiders --install-extension extensions/vscode/documint-*.vsix --force",
    "github:install": "root=\"$PWD\" && cd \"$root/extensions/github\" && bun run build && target=\"$HOME/.copilot/extensions/documint\" && mkdir -p \"$(dirname \"$target\")\" && rm -rf \"$target\" && cp -R \"$root/extensions/github\" \"$target\"",
    "prepublishOnly": "bun build:prod",
    "test": "bun test",
    "check": "vp check",
    "benchmark": "bun scripts/benchmarks/index.ts",
    "benchmark:moby-dick": "bun scripts/benchmarks/moby-dick.ts",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.8",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.11",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  }
}
