{
  "name": "documint",
  "version": "0.0.17",
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun --hot playground/index.html --hostname=0.0.0.0 --port=3003",
    "build:dev": "bun run scripts/build.ts",
    "build:prod": "bun run scripts/build.ts --prod",
    "build:playground": "bun run scripts/build.ts --playground",
    "prepublishOnly": "bun run build:prod",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt . '!test/goldens/**/*.md'",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun run scripts/benchmarks/index.ts"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.7",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dts-bundle-generator": "^9.5.1",
    "lucide-react": "^1.16.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "bun@1.3.11"
}
