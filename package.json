{
  "name": "documint",
  "version": "0.0.26",
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "workspaces": [
    "extensions/*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun --hot playground/index.html --hostname=0.0.0.0 --port=3003",
    "build:dev": "bun run scripts/build/build.ts",
    "build:prod": "bun run scripts/build/build.ts --prod",
    "build:playground": "bun run scripts/build/build.ts --playground",
    "vscode:package": "bun typecheck && cd extensions/vscode && bun package",
    "vscode:install": "code-insiders --install-extension extensions/vscode/documint-*.vsix --force",
    "github:install": "root=\"$PWD\" && cd \"$root/extensions/github\" && bun run build && target=\"$HOME/.copilot/extensions/documint\" && mkdir -p \"$(dirname \"$target\")\" && rm -rf \"$target\" && cp -R \"$root/extensions/github\" \"$target\"",
    "prepublishOnly": "bun run build:prod",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt . '!test/goldens/**/*.md'",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun typecheck && tsc --noEmit -p extensions/vscode/tsconfig.json && tsc --noEmit -p extensions/vscode/tsconfig.webview.json && tsc --noEmit -p extensions/github/tsconfig.json",
    "benchmark": "bun run scripts/benchmarks/index.ts",
    "benchmark:moby-dick": "bun run scripts/benchmarks/moby-dick.ts"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.7",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dts-bundle-generator": "^9.5.1",
    "lucide-react": "^1.16.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "bun@1.3.11"
}
