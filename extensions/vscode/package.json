{
  "name": "documint-vscode",
  "displayName": "Documint",
  "version": "0.0.3",
  "description": "A canvas-based WYSIWYG Markdown editor for VS Code.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostintangent/documint"
  },
  "publisher": "lostintangent",
  "main": "./dist/extension.js",
  "scripts": {
    "build:prod": "bun run --cwd ../.. build:prod && node esbuild.js",
    "package": "vsce package --no-dependencies",
    "install:insiders": "code-insiders --install-extension $npm_package_name-$npm_package_version.vsix --force",
    "vscode:prepublish": "bun run build:prod"
  },
  "dependencies": {
    "@lostintangent/documint": "file:../..",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "documint.markdownEditor",
        "displayName": "Documint",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "engines": {
    "vscode": "^1.120.0"
  }
}
